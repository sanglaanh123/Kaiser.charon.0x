# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# ── Signal server — contact maintainer for access ──────────────────────────
SIGNAL_SERVER_URL=https://api.thecharon.xyz/api
SIGNAL_SERVER_KEY=
SIGNAL_POLL_MS=30000

# ── Jupiter (required: market data, quotes, live swaps) ────────────────────
# Free tier = 1 req/s on the main bucket, so keep max_open_positions <= 3.
# Jupiter Developer plan (10 RPS): JUP_MAIN_RPS=10, JUP_MAIN_RPM=600.
JUPITER_API_KEY=
#JUP_MAIN_RPS=1
#JUP_MAIN_RPM=60
#JUP_DATAPI_RPS=2
# Force GMGN fallback for market data (debug)
#JUP_FORCE_FALLBACK=1
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_SLIPPAGE_BPS=300
LIVE_MIN_SOL_RESERVE=0.02

# ── GMGN enrichment + fallback — set GMGN_ENABLED=false to skip ────────────
GMGN_ENABLED=true
GMGN_API_KEY=
GMGN_REQUEST_DELAY_MS=2500
GMGN_MAX_RETRIES=2
GMGN_CACHE_TTL_MS=300000

# ── PumpPortal — real-time WebSocket signal source ─────────────────────────
PUMPPORTAL_ENABLED=false
PUMPPORTAL_API_KEY=

# ── Pre-graduation scanner (pump.fun REST) ─────────────────────────────────
PREGRAD_ENABLED=false
PREGRAD_POLL_MS=30000
PREGRAD_LOOKBACK_MS=7200000
PREGRAD_MAX_AGE_MS=43200000
PREGRAD_MIN_RSSR_SOL=0
PREGRAD_MAX_RSSR_SOL=100
PREGRAD_MAX_ATH_MULTIPLE=10

# pump.fun REST is behind Cloudflare; pregrad/graduated fall back to a local
# headless-Chromium sidecar. Only override if you run it on another port/host.
#CHARON_CF_FETCH_URL=http://127.0.0.1:8799

# ── Solana RPC ─────────────────────────────────────────────────────────────
# RPC is only required for TRADING_MODE=live/confirm.
# The WS endpoint (SOLANA_WS_URL or HELIUS_API_KEY) enables the on-chain fee-claim listener.
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_WS_URL=
# On-chain fee-claim WS listener (default on when SOLANA_WS_URL/HELIUS_API_KEY set)
#FEE_CLAIM_WS_ENABLED=true

# ── Trading ────────────────────────────────────────────────────────────────
DB_PATH=./charon.sqlite
# dry_run | confirm | live
TRADING_MODE=dry_run
# Live / confirm only — use a dedicated trading wallet, never your main one.
# SOLANA_PRIVATE_KEY and PRIVATE_KEY are both read; set SOLANA_PRIVATE_KEY.
SOLANA_PRIVATE_KEY=
MAX_OPEN_POSITIONS=3
POSITION_CHECK_MS=10000

# ── Jev (TypeSafe System One) decision engine ──────────────────────────────
# NOTE: llm_min_confidence now means P(BUY)x100 from Jev, not a self-rated score; recalibrate in dry_run before going live.
ENABLE_JEV=true
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=15000
LLM_CANDIDATE_PICK_COUNT=10
LLM_CANDIDATE_MAX_AGE_MS=600000

# ── Candidate floors — applied before strategy gates ───────────────────────
MIN_HOLDERS=0
MIN_MCAP_USD=0
PUMP_FUN_GRADUATION_MCAP_USD=69000
MIN_FEE_CLAIM_SOL=2
GRADUATED_POLL_MS=30000
GRADUATED_LOOKBACK_MS=7200000

# ── Trending (>= 60s enforced; Jupiter with GMGN fallback) ─────────────────
TRENDING_POLL_MS=60000
TRENDING_LOOKBACK_MS=600000
TRENDING_ENABLED=true
TRENDING_SOURCE=jupiter
TRENDING_ALLOW_DEGEN=false
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume
TRENDING_MIN_VOLUME_USD=0
TRENDING_MIN_SWAPS=0
TRENDING_MAX_RUG_RATIO=0.3
TRENDING_MAX_BUNDLER_RATE=0.5

# ── Debug helpers — leave unset in normal operation ────────────────────────
CHARON_GRADUATED_TEST=
CHARON_TEST_MINT=
